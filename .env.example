# AI 学习助手（仅服务端部署时生效；静态导出/GitHub Pages 不使用）
# 复制为 .env.local 后填写。密钥只在服务端读取，切勿使用 NEXT_PUBLIC_ 前缀。

# anthropic（官方 SDK）或 openai（OpenAI 兼容接口）
AI_PROVIDER=anthropic
AI_API_KEY=
# anthropic 默认 claude-opus-5-5；openai 兼容接口必须填写
AI_MODEL=
# 仅 openai 兼容接口需要，如 https://api.example.com/v1
AI_BASE_URL=
# anthropic 推理强度：low | medium | high
AI_EFFORT=medium

# 可选：静态部署时让前端调用你自建的代理（代理负责保存密钥）
# NEXT_PUBLIC_TUTOR_ENDPOINT=https://your-proxy.example.com/api/tutor

# 可选：GitHub Pages 子路径（工作流中自动设置）
# NEXT_PUBLIC_BASE_PATH=/analoglab
